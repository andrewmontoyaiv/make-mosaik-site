<header
  class="fixed inset-x-0 top-0 z-50 bg-black border-b border-gray-500"
  x-data="{ navOpen: false }"
  @keydown.escape.window="navOpen = false"
>
  <div
    class="
      mx-auto
      flex
      max-w-[1600px]
      items-center
      justify-between
      px-6
      py-5
      md:px-10
      lg:px-16
    "
  >
  <a
    href="/"
    class="
      text-sm font-semibold tracking-[0.18em]
      text-white
    "
  >
    MAKE MOSAIK
  </a>

    <nav
      class="
        hidden
        items-center
        gap-10
        text-sm
        font-medium
        uppercase
        tracking-[0.16em]
        md:flex
      "
      aria-label="Primary navigation"
    >

      <a
        href="/projects/"
        class="
          transition-opacity
          duration-200
          hover:opacity-60
        "
      >
        Projects
      </a>



      <a
        href="/about/"
        class="
          transition-opacity
          duration-200
          hover:opacity-60
        "
      >
        About Us
      </a>

      <a
        href="/contact/"
        class="
          transition-opacity
          duration-200
          hover:opacity-60
        "
      >
        Contact
      </a>
    </nav>

    <button
      type="button"
      class="
        relative
        z-50
        flex
        h-11
        w-11
        items-center
        justify-center
        md:hidden
      "
      @click="navOpen = !navOpen"
      :aria-expanded="navOpen"
      aria-controls="mobile-navigation"
      aria-label="Toggle navigation"
    >
      <span class="sr-only">Menu</span>

      <span
        class="
          absolute
          h-px
          w-7
          bg-white
          transition
          duration-300
        "
        :class="navOpen
          ? 'translate-y-0 rotate-45'
          : '-translate-y-2'"
      ></span>

      <span
        class="
          absolute
          h-px
          w-7
          bg-white
          transition
          duration-300
        "
        :class="navOpen
          ? 'opacity-0'
          : 'opacity-100'"
      ></span>

      <span
        class="
          absolute
          h-px
          w-7
          bg-white
          transition
          duration-300
        "
        :class="navOpen
          ? 'translate-y-0 -rotate-45'
          : 'translate-y-2'"
      ></span>
    </button>
  </div>

  <div
    id="mobile-navigation"
    class="
      fixed
      inset-0
      z-40
      bg-black
      md:hidden
    "
    x-show="navOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    x-cloak
  >
    <nav
      class="
        flex
        h-full
        flex-col
        justify-center
        px-8
      "
      aria-label="Mobile navigation"
    >
      <div
        class="
          flex
          flex-col
          gap-7
          text-4xl
          font-light
          uppercase
          tracking-tight
        "
      >
        <a
          href="/projects/"
          @click="navOpen = false"
          class="
            border-b
            border-white/15
            pb-5
            transition-opacity
            hover:opacity-60
          "
        >
          Projects
        </a>

        <a
          href="/about/"
          @click="navOpen = false"
          class="
            border-b
            border-white/15
            pb-5
            transition-opacity
            hover:opacity-60
          "
        >
          About Us
        </a>

        <a
          href="/contact/"
          @click="navOpen = false"
          class="
            border-b
            border-white/15
            pb-5
            transition-opacity
            hover:opacity-60
          "
        >
          Contact
        </a>
      </div>

      <p
        class="
          absolute
          bottom-8
          left-8
          text-xs
          uppercase
          tracking-[0.22em]
          text-white/50
        "
      >
        Many things, one mosaik
      </p>
    </nav>
  </div>
</header>

















