---
layout: layouts/base.njk
title: Contact
description: Get in touch with Make Mosaik.
---

<section
  class="
    min-h-screen
    bg-black
    px-6
    pb-24
    pt-32
    text-white
    md:px-10
    md:pt-40
    lg:px-16
  "
>
  <div
    class="
      mx-auto
      grid
      max-w-7xl
      gap-16
      lg:grid-cols-[0.8fr_1.2fr]
      lg:gap-24
    "
  >

    <div>
      <p
        class="
          mb-5
          text-sm
          uppercase
          tracking-[0.24em]
          text-white/50
        "
      >
        Contact Us
      </p>

      <h1
        class="
          text-5xl
          font-light
          leading-[0.95]
          tracking-tight
          sm:text-6xl
          lg:text-7xl
        "
      >
        LET'S MAKE<br>
        SOMETHING.
      </h1>

      <p
        class="
          mt-8
          max-w-md
          text-lg
          leading-relaxed
          text-white/65
        "
      >
        Have a project, collaboration, event, question, or strange idea?
        Send it our way.
      </p>

      <div
        class="
          mt-14
          border-t
          border-white/15
          pt-8
        "
      >
        <p
          class="
            text-xs
            uppercase
            tracking-[0.2em]
            text-white/35
          "
        >
          Make Mosaik
        </p>

        <p
          class="
            mt-3
            max-w-sm
            text-sm
            leading-relaxed
            text-white/50
          "
        >
          Games, music, animation, community projects, experiments,
          and whatever comes next.
        </p>
      </div>
    </div>

    <div
      class="
        border
        border-white/15
        p-6
        md:p-10
      "
    >
      <form
        action=""
        method="POST"
        class="space-y-8"
      >

        <div>
          <label
            for="name"
            class="
              mb-3
              block
              text-xs
              uppercase
              tracking-[0.2em]
              text-white/50
            "
          >
            Name
          </label>

          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
            class="
              w-full
              border-0
              border-b
              border-white/25
              bg-transparent
              px-0
              py-3
              text-lg
              text-white
              outline-none
              transition-colors
              placeholder:text-white/25
              focus:border-white
              focus:ring-0
            "
            placeholder="Your name"
          >
        </div>

        <div>
          <label
            for="email"
            class="
              mb-3
              block
              text-xs
              uppercase
              tracking-[0.2em]
              text-white/50
            "
          >
            Email
          </label>

          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="
              w-full
              border-0
              border-b
              border-white/25
              bg-transparent
              px-0
              py-3
              text-lg
              text-white
              outline-none
              transition-colors
              placeholder:text-white/25
              focus:border-white
              focus:ring-0
            "
            placeholder="you@example.com"
          >
        </div>

        <div>
          <label
            for="subject"
            class="
              mb-3
              block
              text-xs
              uppercase
              tracking-[0.2em]
              text-white/50
            "
          >
            What's this about?
          </label>

          <select
            id="subject"
            name="subject"
            class="
              w-full
              border-0
              border-b
              border-white/25
              bg-black
              px-0
              py-3
              text-lg
              text-white
              outline-none
              transition-colors
              focus:border-white
              focus:ring-0
            "
          >
            <option value="general">General</option>
            <option value="project">Project or collaboration</option>
            <option value="creative-corner">Creative Corner</option>
            <option value="backrooms-duck">Backrooms Duck</option>
            <option value="other">Something else</option>
          </select>
        </div>

        <div>
          <label
            for="message"
            class="
              mb-3
              block
              text-xs
              uppercase
              tracking-[0.2em]
              text-white/50
            "
          >
            Message
          </label>

          <textarea
            id="message"
            name="message"
            rows="7"
            required
            class="
              w-full
              resize-none
              border
              border-white/20
              bg-white/[0.02]
              p-4
              text-base
              leading-relaxed
              text-white
              outline-none
              transition-colors
              placeholder:text-white/25
              focus:border-white/60
              focus:ring-0
            "
            placeholder="Tell us what you're thinking..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="
            group
            inline-flex
            items-center
            gap-5
            text-sm
            font-medium
            uppercase
            tracking-[0.2em]
          "
        >
          <span
            class="
              flex
              h-12
              w-12
              items-center
              justify-center
              rounded-full
              border
              border-white/40
              transition-all
              duration-300
              group-hover:bg-white
              group-hover:text-black
            "
            aria-hidden="true"
          >
            →
          </span>

          Send Message
        </button>

      </form>
    </div>

  </div>
</section>