---
layout: layouts/base.njk
title: Projects
description: Explore the projects created under Make Mosaik.
---

<section
  class="
    min-h-screen
    bg-black
    px-6
    pb-24
    pt-32
    text-white
    md:px-10
    md:pt-40
    lg:px-16
  "
  x-data="{ filter: 'all' }"
>
  <div class="mx-auto max-w-7xl">

    <div
      class="
        grid
        gap-10
        lg:grid-cols-[0.85fr_1.15fr]
        lg:items-end
        lg:gap-20
      "
    >
      <div>
        <p
          class="
            mb-5
            text-sm
            uppercase
            tracking-[0.24em]
            text-white/50
          "
        >
          Make Mosaik
        </p>

        <h1
          class="
            text-5xl
            font-light
            leading-[0.95]
            tracking-tight
            sm:text-6xl
            lg:text-7xl
          "
        >
          OUR<br>
          PROJECTS
        </h1>
      </div>

      <p
        class="
          max-w-2xl
          text-lg
          font-light
          leading-relaxed
          text-white/65
          md:text-xl
        "
      >
        Games, events, experiments, animation, music, software,
        and whatever else finds its way into the mosaik.
      </p>
    </div>

    <div
      class="
        mt-16
        flex
        flex-wrap
        gap-x-7
        gap-y-4
        border-y
        border-white/15
        py-6
      "
    >
      <button
        type="button"
        @click="filter = 'all'"
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          transition-opacity
          hover:opacity-60
        "
        :class="filter === 'all'
          ? 'text-white'
          : 'text-white/35'"
      >
        All
      </button>

      <button
        type="button"
        @click="filter = 'games'"
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          transition-opacity
          hover:opacity-60
        "
        :class="filter === 'games'
          ? 'text-white'
          : 'text-white/35'"
      >
        Games
      </button>

      <button
        type="button"
        @click="filter = 'community'"
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          transition-opacity
          hover:opacity-60
        "
        :class="filter === 'community'
          ? 'text-white'
          : 'text-white/35'"
      >
        Community
      </button>

      {# <button
        type="button"
        @click="filter = 'animation'"
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          transition-opacity
          hover:opacity-60
        "
        :class="filter === 'animation'
          ? 'text-white'
          : 'text-white/35'"
      >
        Animation
      </button> #}

      {# <button
        type="button"
        @click="filter = 'software'"
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          transition-opacity
          hover:opacity-60
        "
        :class="filter === 'software'
          ? 'text-white'
          : 'text-white/35'"
      >
        Software
      </button> #}

      {# <button
        type="button"
        @click="filter = 'experiments'"
        class="
          text-xs
          uppercase
          tracking-[0.2em]
          transition-opacity
          hover:opacity-60
        "
        :class="filter === 'experiments'
          ? 'text-white'
          : 'text-white/35'"
      >
        Experiments
      </button> #}
    </div>

    <div
      class="
        mt-12
        grid
        gap-x-8
        gap-y-14
        md:grid-cols-2
      "
    >
      {% for project in projects %}
        <article
          x-show="
            filter === 'all' ||
            filter === '{{ project.category | lower }}'
          "
          x-transition.opacity.duration.250ms
          class="group"
        >
          <a
            href="{{ project.url }}"
            class="block"
          >
            <div
              class="
                relative
                aspect-[16/10]
                overflow-hidden
                bg-white/5
              "
            >
              <img
                src="{{ project.image }}"
                alt="{{ project.title }}"
                class="
                  h-full
                  w-full
                  object-cover
                  transition-transform
                  duration-700
                  ease-out
                  group-hover:scale-[1.03]
                "
              >

              <div
                class="
                  absolute
                  inset-0
                  bg-black/0
                  transition-colors
                  duration-300
                  group-hover:bg-black/10
                "
              ></div>

              <div
                class="
                  absolute
                  bottom-5
                  right-5
                  flex
                  h-12
                  w-12
                  items-center
                  justify-center
                  rounded-full
                  border
                  border-white/40
                  bg-black/20
                  text-lg
                  backdrop-blur-sm
                  transition-all
                  duration-300
                  group-hover:bg-white
                  group-hover:text-black
                "
                aria-hidden="true"
              >
                →
              </div>
            </div>

            <div class="mt-6">
              <p
                class="
                  text-xs
                  uppercase
                  tracking-[0.2em]
                "
                style="color: {{ project.accent }};"
              >
                {{ project.category }}
              </p>

              <div
                class="
                  mt-3
                  flex
                  items-start
                  justify-between
                  gap-6
                "
              >
                <h2
                  class="
                    text-2xl
                    font-light
                    tracking-tight
                    md:text-3xl
                  "
                >
                  {{ project.title }}
                </h2>
              </div>

              {% if project.tagline %}
                <p
                  class="
                    mt-3
                    max-w-xl
                    text-sm
                    leading-relaxed
                    text-white/50
                  "
                >
                  {{ project.tagline }}
                </p>
              {% endif %}
            </div>
          </a>
        </article>
      {% endfor %}
    </div>

  </div>
</section>